# Database Settings
DATABASE_URL = MY_DB_URL
DB_SERVICE_CA_PATH = RELATIVE_PATH_TO_DB_SERVICE_CA.PEM

# CORS Origin
CORS_ORIGIN = http://localhost:3000

# AES Encryption Key
ENCRYPTION_KEY = "AES_ENCRYPTION_KEY_FOR_SOME_DB_COLUMNS"

# JWT Settings (Use "openssl rand -hex 32" for generating a "JWT_SECRET_KEY")
JWT_ALGORITHM  = HS256
JWT_SECRET_KEY = FRANKY_SUUUPPPERRRR_SECRET_JWT_KEY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 30

# Encryption Key use generator.py dude i created it in the root folder
ENCRYPTION_KEY = YOUR_FERNET_KEY_HERE

# Google OAuth Settings
GOOGLE_CLIENT_ID     = CLIENT_ID
GOOGLE_CLIENT_SECRET = CLIENT_SECRET
GOOGLE_REDIRECT_URI  = http://localhost:8000/auth/google/callback

# Google Drive Upload Settings
GOOGLE_DRIVE_UPLOAD_REQUEST_URL = https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable

# Application Metadata
APP_NAME = DriveGate
APP_VERSION = 1.0.0